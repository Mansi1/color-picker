    "typescript": "^7.0.2"
  },
  "module": "dist/color-picker.js",
  "types": "dist/color-picker.d.ts",
  "unpkg": "dist/color-picker.min.js",
  "jsdelivr": "dist/color-picker.min.js",
  "homepage": "https://mansi1.github.io/color-picker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mansi1/color-picker.git"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
